              }
            ],
            [
              {
                "text": "ecat"
              },
              {
                "text": "ECAT, E, LTR"
              }
            ],
            [
              {
                "text": "eCat"
              },
              {
                "text": "ECAT, E, LTR, CAT"
              }
            ],
            [
              {
                "text": "eCAT"
              },
              {
                "text": "ECAT, E, LTR, CAT"
              }
