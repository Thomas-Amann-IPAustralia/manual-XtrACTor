          "source": "markup"
        },
        {
          "level": 4,
          "ref": "TMM/Part4/6/6/3/6",
          "source": "emphasis"
        }
      ],
      "internal_refs": [],
      "kind": "body",
      "links": [],
      "ordinal": 11,
      "page_ref": "TMM/Part4/6",
      "provisions": [],
      "tables": [],
      "text": "If notification did not occur within 14 days, the receipt date of the document is the filing date, and the date must be adjusted when the fee is allocated."
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Other than new trade mark applications, these documents are tracked using manual records through a 10 business day (5 days for hearings/oppositions) period and a refund processed if relevant."
        }
      ],
      "cases": [],
