        "Part 4.6. No fee paid",
        "6.3 Notification of non payment",
        "6.3.4"
      ],
      "heading_source": "emphasis",
      "headings": [
        {
          "level": 3,
          "ref": null,
          "source": "markup"
        },
        {
          "level": 4,
          "ref": "TMM/Part4/6/6/3/4",
          "source": "emphasis"
        }
      ],
      "internal_refs": [],
      "kind": "body",
      "links": [],
      "ordinal": 9,
      "page_ref": "TMM/Part4/6",
      "provisions": [],
      "tables": [],
      "text": "The notification is recorded in the outbound correspondence record."
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "If notification occurred within 14 days, when the payment is made, the document is taken to have been filed on the date the money is received. The receipt date for this money is the filing date."
        }
      ],
      "cases": [],
      "chunk_ref": "TMM/Part4/6/6/3/5",
      "content_hash": "sha256:9dc00ad89f318364c39c50ffce8787384c7bdd915159594dcea2d81a4aeaff2e",
      "fragment": null,
      "heading_path": [
        "Part 4 Fees",
        "Part 4.6. No fee paid",
        "6.3 Notification of non payment",
        "6.3.5"
      ],
      "heading_source": "emphasis",
      "headings": [
        {
          "level": 3,
          "ref": null,
          "source": "markup"
        },
        {
          "level": 4,
          "ref": "TMM/Part4/6/6/3/5",
          "source": "emphasis"
        }
      ],
      "internal_refs": [],
      "kind": "body",
      "links": [],
      "ordinal": 10,
      "page_ref": "TMM/Part4/6",
      "provisions": [],
      "tables": [],
      "text": "If notification occurred within 14 days, when the payment is made, the document is taken to have been filed on the date the money is received. The receipt date for this money is the filing date."
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "If notification did not occur within 14 days, the receipt date of the document is the filing date, and the date must be adjusted when the fee is allocated."
        }
      ],
      "cases": [],
      "chunk_ref": "TMM/Part4/6/6/3/6",
      "content_hash": "sha256:277a2a614a4fb67d90ad21a3d8115fff3c0a22b2098a1741f50b77f057bf86b7",
      "fragment": null,
      "heading_path": [
