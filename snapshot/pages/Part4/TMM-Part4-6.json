          "level": 3,
          "ref": null,
          "source": "markup"
        },
        {
          "level": 4,
          "ref": "TMM/Part4/6/6/3/3",
          "source": "emphasis"
        }
      ],
      "internal_refs": [],
      "kind": "body",
      "links": [],
      "ordinal": 8,
      "page_ref": "TMM/Part4/6",
      "provisions": [
        {
          "certainty": "default",
          "extraction": "regex",
          "id": "TMA1995/s223(5)",
          "mention": "subsection 223(5)"
        },
        {
