          "mention": "reg 21.23"
        }
      ],
      "tables": [],
      "text": "If the Registrar does not notify the person within the 14 days allowed by subsection 223(5) (reg 21.23), the document is taken to be filed on the date it is received."
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "The notification is recorded in the outbound correspondence record."
        }
      ],
      "cases": [],
      "chunk_ref": "TMM/Part4/6/6/3/4",
      "content_hash": "sha256:43178fcd285ba8088056514ac158f3125c37f880d3eee0ce8b0eedb339103ebf",
      "fragment": null,
      "heading_path": [
