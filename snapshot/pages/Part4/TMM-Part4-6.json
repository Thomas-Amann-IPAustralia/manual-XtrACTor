          "id": "TMR1995/r21.23",
          "mention": "reg 21.23"
        }
      ],
      "tables": [],
      "text": "If the Registrar notifies the person within the 14 days allowed by subsection 223(5) (reg 21.23), the document is taken not to have been filed until the fee is paid."
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "If the Registrar does not notify the person within the 14 days allowed by subsection 223(5) (reg 21.23), the document is taken to be filed on the date it is received."
        }
      ],
      "cases": [],
      "chunk_ref": "TMM/Part4/6/6/3/3",
      "content_hash": "sha256:fd5c49a10cbb23d79f2d2f7886752eae55efdc205a30754e1054b954a4f0295f",
      "fragment": null,
      "heading_path": [
