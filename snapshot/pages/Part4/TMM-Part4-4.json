      "text": "Trade Marks Act 1995 Trade Mark Regulations 1995 If fees are underpaid, the following procedures apply:"
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "If a fee is underpaid, the person who paid the fee must be notified of the deficiency by the relevant work area as soon as possible."
        }
      ],
      "cases": [],
      "chunk_ref": "TMM/Part4/4/4/1/1",
      "content_hash": "sha256:c0b40522fe6ddc5c4042168a713b95777daf5f5321a4913f3fae80b8029beee3",
      "emphasis": [],
      "fragment": null,
      "heading_path": [
