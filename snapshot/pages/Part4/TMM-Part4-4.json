          "source": "emphasis"
        }
      ],
      "internal_refs": [],
      "kind": "body",
      "links": [],
      "ordinal": 4,
      "page_ref": "TMM/Part4/4",
      "provisions": [],
      "tables": [],
      "text": "The notification is recorded in the outward correspondence record."
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "If the Registrar notifies the person in the 14 days allowed by subsection 223(5) (reg 21.23), the document is taken as not filed or the act is taken as not done until the deficiency is made good."
        }
      ],
      "cases": [],
      "chunk_ref": "TMM/Part4/4/4/1/4",
      "content_hash": "sha256:9c7830c375ee60c752637b55bd5a9c6a23348643ec5e3a3700b9f7089edc0be4",
      "emphasis": [],
