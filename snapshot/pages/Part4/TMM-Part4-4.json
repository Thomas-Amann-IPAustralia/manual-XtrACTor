        }
      ],
      "internal_refs": [],
      "kind": "body",
      "links": [],
      "ordinal": 2,
      "page_ref": "TMM/Part4/4",
      "provisions": [],
      "tables": [],
      "text": "If a fee is underpaid, the person who paid the fee must be notified of the deficiency by the relevant work area as soon as possible."
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "When the relevant work area receives correspondence, it should be checked for underpayments so that immediate notification action can be taken."
        }
      ],
      "cases": [],
      "chunk_ref": "TMM/Part4/4/4/1/2",
      "content_hash": "sha256:c2ac7d527a36e0b574dcfca63e452dee5975ef1e804929290079c95a8f98e8a3",
      "emphasis": [],
      "fragment": null,
      "heading_path": [
