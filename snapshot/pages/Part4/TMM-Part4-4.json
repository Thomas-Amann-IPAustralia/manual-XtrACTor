          "source": "emphasis"
        }
      ],
      "internal_refs": [],
      "kind": "body",
      "links": [],
      "ordinal": 3,
      "page_ref": "TMM/Part4/4",
      "provisions": [],
      "tables": [],
      "text": "When the relevant work area receives correspondence, it should be checked for underpayments so that immediate notification action can be taken."
    },
    {
      "blocks": [
        {
          "kind": "paragraph",
          "text": "The notification is recorded in the outward correspondence record."
        }
      ],
      "cases": [],
      "chunk_ref": "TMM/Part4/4/4/1/3",
      "content_hash": "sha256:eae0bb1dc7adebe6bb80cf20ee4229f841047b239e5adbdb272765f94f7ed7a9",
      "emphasis": [],
      "fragment": null,
