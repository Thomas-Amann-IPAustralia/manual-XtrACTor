        {
          "depth": 1,
          "kind": "list_item",
          "text": "EL rights,"
        },
        {
          "depth": 1,
          "kind": "list_item",
          "text": "or words or symbols to the same effect (including the symbols \"©\" and \"®\")."
        },
        {
          "kind": "paragraph",
          "text": "(For the meaning of “EL rights” see section 5 of the Circuit Layouts Act 1989.)"
        }
      ],
