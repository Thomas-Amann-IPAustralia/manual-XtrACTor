          "start": 0,
          "text": "Regs 4.15(da) and (e)"
        }
      ],
      "ordinal": 6,
      "page_ref": "TMM/Part31/2",
      "provisions": [
        {
          "extraction": "href",
          "id": "TMR1995/r4.15(da)",
