          "text": "Protected International Trade Mark"
        },
        {
          "depth": 1,
          "kind": "list_item",
          "text": "Registered,"
        },
        {
          "depth": 1,
          "kind": "list_item",
          "text": "Registered Design,"
        },
        {
          "depth": 1,
          "kind": "list_item",
          "text": "Copyright,"
        },
        {
          "depth": 1,
          "kind": "list_item",
          "text": "Plant Breeder’s Rights,"
