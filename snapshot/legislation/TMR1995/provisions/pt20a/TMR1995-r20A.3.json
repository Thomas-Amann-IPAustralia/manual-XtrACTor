  "heading_path": [
    "Trade Marks Regulations 1995",
    "Part 20A—Incorporated trade marks attorneys",
    "Division 2—Obtaining registration for first time",
    "20A.3  Form of application"
  ],
  "instrument": "TMR1995",
  "kind": "regulation",
  "number": "20A.3",
  "ref": "TMR1995/r20A.3",
  "text": "An application for registration as an incorporated trade marks attorney must: (a) be in writing, in a form approved by the Designated Manager; and (b) be accompanied by the following evidence and material: (i) the name of each trade marks attorney director of the company; (ii) evidence that the company is a registered company under the Corporations Act 2001; (iii) evidence that the company has adequate and appropriate professional indemnity insurance; and (c) be accompanied by the fee set out in item 36 of Schedule 9.",
