  "heading_path": [
    "Trade Marks Regulations 1995",
    "Part 22—Application, saving and transitional provisions",
    "Division 1—General",
    "22.7  Trade marks attorneys"
  ],
  "instrument": "TMR1995",
  "kind": "regulation",
  "number": "22.7",
  "ref": "TMR1995/r22.7",
  "text": "For registration as a trade marks attorney, a person is taken to meet the requirements of subregulation 20.1(1) until 27 January 2001 if the person: (a) was, on 28 February 1998, registered as a patent attorney under section 198 of the Patents Act 1990; or (b) met the requirements of paragraphs 198(2)(c) and (d) of the Patents Act 1990 as in force on 26 January 1999; or (c) is a legal practitioner who acted for a client in trade mark matters before 27 January 1999, and makes a declaration to that effect; or (d) is a person to whom note 4 to subsection 156(2) of the Trade Marks Act 1995 applies.",
  "title": "Trade marks attorneys",
