  "heading_path": [
    "Trade Marks Act 1995",
    "Part 7—Registration of trade marks",
    "Division 2—Renewal of registration (general)",
    "74A  Application of this Division"
  ],
  "instrument": "TMA1995",
  "kind": "section",
  "number": "74A",
  "ref": "TMA1995/s74A",
  "text": "This Division applies to a registered trade mark if: (a) particulars of registration were entered in the Register under section 69 before the end of the period of 10 years after the filing date of the application for registration; or (b) both: (i) paragraph (a) does not apply; and (ii) registration has already been renewed under Division 3 for a period that includes the day on which particulars of registration were entered in the Register under section 69. Note: For filing date see section 6.",
