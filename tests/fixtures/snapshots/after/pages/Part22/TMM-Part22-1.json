      ],
      "internal_refs": [],
      "kind": "body",
      "ordinal": 2,
      "page_ref": "TMM/Part22/1",
      "provisions": [],
      "text": "The repealed section 41 is set out in full in Annex A1 to this Part of the Manual, and in Annex A2."
    },
    {
      "cases": [],
      "chunk_ref": "TMM/Part22/1/3",
      "content_hash": "sha256:b982e83d86c7921f9006130763a83158c8a08dac1b5a1f47d746c51d3cecc68b",
      "fragment": null,
      "heading_path": [
